<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>GrowLog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.zdmgold.growlog</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>growlog</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- The in-app camera scans plants and takes photos for plant records. -->
	<key>NSCameraUsageDescription</key>
	<string>GrowLog uses your camera to scan your plants and take photos for your plant records.</string>

	<!-- Choosing an existing photo of a plant to scan or keep in its record. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GrowLog accesses your photo library so you can choose an existing photo of a plant to scan or keep in its record.</string>

	<!-- The camera plugin's README asks for this key and App Store checks flag a
	     missing purpose string. GrowLog never records audio. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>GrowLog does not record audio. This is listed only because the camera component can reference the microphone.</string>

	<!-- App Tracking Transparency: AdMob (google_mobile_ads) is active.
	     NOTE: no code in the app shows the ATT prompt yet. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier will be used to deliver personalized ads to you.</string>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- AdMob requires this key in Info.plist as well as the Android
	     manifest meta-data. REPLACE with the real iOS AdMob App ID
	     before release — this is a test ID. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
</dict>
</plist>
