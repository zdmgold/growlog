<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>GrowLog</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>com.zdmgold.growlog</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>growlog</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- add_plant_screen.dart's _takePhoto() calls the camera
	     directly. Specific to the real feature, not a generic
	     placeholder, per store-review requirements. -->
	<key>NSCameraUsageDescription</key>
	<string>GrowLog uses your camera to take progress photos of your plants, stored locally on your device.</string>

	<!-- add_plant_screen.dart's _pickPhoto() reads from the photo
	     library to attach an existing photo to a plant. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>GrowLog accesses your photo library so you can choose an existing photo of your plant to track its growth.</string>

	<!-- Required because AdMob (google_mobile_ads) is active —
	     App Tracking Transparency prompt, reviewers check for this
	     specifically per Apple's ATT policy. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>This identifier will be used to deliver personalized ads to you.</string>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- AdMob requires this key in Info.plist as well as the Android
	     manifest meta-data. REPLACE with the real iOS AdMob App ID
	     before release — this is a test ID. -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-3940256099942544~1458002511</string>
</dict>
</plist>
